(version 1)
(allow default)
(deny network*)
(allow network-bind (regex #"^/private/tmp/calccrm-t18-ui-[^/]+/socket/"))
(allow network-outbound (regex #"^/private/tmp/calccrm-t18-ui-[^/]+/socket/"))
(allow network-bind (local tcp "*:18881"))
(allow network-bind (local tcp "*:18882"))
(allow network-bind (local tcp "*:18883"))
(allow network-inbound (local tcp "*:18881"))
(allow network-inbound (local tcp "*:18882"))
(allow network-inbound (local tcp "*:18883"))
(allow network-outbound (remote ip "localhost:18881"))
(allow network-outbound (remote ip "localhost:18882"))
(allow network-outbound (remote ip "localhost:18883"))
